{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sorter",
  "mainBinaryName": "sorter",
  "version": "1.4.1",
  "identifier": "com.stillmvd.sorter",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1430",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Sorter",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 720,
        "center": true,
        "decorations": false,
        "dragDropEnabled": false,
        "visible": false,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection,OptimizationHints,AutofillServerCommunication,MediaRouter,EdgeFeedback,msEdgeFeedback --disable-background-networking --disable-component-update --disable-domain-reliability --disable-sync --no-pings"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "publisher": "stillmvd",
    "copyright": "© stillmvd",
    "shortDescription": "Раскладка видео по папкам",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "targets": [
      "nsis"
    ],
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "languages": [
          "Russian"
        ],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "installerHooks": "./windows/hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEIxQjZFRUFGNkY1MjZFNzgKUldSNGJsSnZyKzYyc2FkbkNJYUk3NmlUdGhhWjJBV0EwdnJobXBCaE50YW54bU5JNDU1blhkQzgK",
      "endpoints": [
        "https://github.com/stillmvd/sorter/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "quiet"
      }
    }
  }
}
